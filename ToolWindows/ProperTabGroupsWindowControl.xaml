<UserControl x:Class="ProperTabGroups.ProperTabGroupsWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsShell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:tabGroupScripts="clr-namespace:ProperTabGroups.TabGroupScripts"
             xmlns:local="clr-namespace:ProperTabGroups.ToolWindows.OptionsWindow"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:Background="White"
			 x:Name="window"
             DataContext="{Binding ElementName=window, Path=ViewModel}">


    <UserControl.Resources>

        <!--___________________________________________-->
        <!--____________Base ListView Style____________-->
        <!--___________________________________________-->
        <Style TargetType="ListView" x:Key="DefaultListViewStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
            <!-- Style to remove margin for the nested ListView -->
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Style to remove focus and more for the ListViewItem -->
            <Setter Property="Focusable" Value="false"/>
            <!-- Remove indentation for the nested ListView -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!--___________________________________________-->
        <!--______________Scroll Bar Base______________-->
        <!--___________________________________________-->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.ScrollBarThumbBackgroundKey}}"/>
        </Style>

        <!--_____________________________________________-->
        <!--______________Context Menu Base______________-->
        <!--_____________________________________________-->
        <Style TargetType="ContextMenu">

            <!-- Background and Foreground setters -->
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>

            <!-- Additional styling for better theme matching -->
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarBorderKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="MenuItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.MenuTextKey}}"/>
                        <!-- Hover and Pressed States -->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarHoverOverSelectedKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarTextSelectedKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarMouseDownBackgroundBeginKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarTextSelectedKey}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <!-- Adjust the Popup part of the ContextMenu to ensure proper theming -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--_____________________________________________-->
        <!--___________TabGroup List View Item___________-->
        <!--_____________________________________________-->
        <Style TargetType="ListViewItem" x:Key="TabGroupListItem">

            <!-- Style to remove padding and border for the ListViewItem -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>

            <Setter Property="BorderThickness" Value="0"/>


            <!-- Style stretch the clickable content to the width of the window-->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="FontFamily" Value="{DynamicResource {x:Static  vsShell:VsFonts.EnvironmentFontFamilyKey}}"/>
            <Setter Property="FontSize" Value="{DynamicResource {x:Static vsShell:VsFonts.EnvironmentFontSizeKey}}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <!--<Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.DebuggerDataTipActiveHighlightTextKey}}"/>-->
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <!--<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.ToolboxIconHighlightKey}}"/>-->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--_____________________________________________-->
        <!--____________TabGroup Context Menu____________-->
        <!--_____________________________________________-->
        <ContextMenu x:Key="TabGroupContextMenu" FlowDirection="LeftToRight" HorizontalAlignment="Left">
            <MenuItem Header="Rename" ></MenuItem>
            <MenuItem Header="Delete Group" Click="DeleteGroup_OnClick" />
        </ContextMenu>

        <!--____________________________________________-->
        <!--____________TabInfo Context Menu____________-->
        <!--____________________________________________-->
        <ContextMenu x:Key="TabInfoContextMenu">
            <MenuItem Header="Modify filters" Click="ModifyFilters_OnClick"></MenuItem>
            <MenuItem Header="Clear filters" Click="ClearFilters_OnClick"></MenuItem>
        </ContextMenu>

        <!--_____________________________________________-->
        <!--_________Group Hiding Bool Converter_________-->
        <!--_____________________________________________-->
        <!--<BooleanToVisibilityConverter x:Key="BoolToVis" />-->

        <!--____________________________________________-->
        <!--__________Tab Info List View Style__________-->
        <!--____________________________________________-->
        <Style TargetType="ListViewItem" x:Key="TabInfoListViewStyle">

            <Setter Property="Padding" Value="0"/>
            <!-- Style to remove padding and border for the ListViewItem -->
            <Setter Property="Margin" Value="10,0,0,0"/>

            <Setter Property="BorderThickness" Value="1"/>
            <!--<Setter Property="BorderBrush" Value="Aqua"/>-->

            <!-- Style to select the tab when we want it selected -->
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />

            <!-- Style stretch the clickable content to the width of the window-->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <!-- Setting Context Menu for nested List View Items-->
            <Setter Property="ContextMenu" Value="{StaticResource TabInfoContextMenu}"/>

            <EventSetter Event="MouseDoubleClick" Handler="ModifyFilters_OnClick"/>

            <!-- Setting the background styles -->
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="FontFamily" Value="{DynamicResource {x:Static  vsShell:VsFonts.EnvironmentFontFamilyKey}}"/>
            <Setter Property="FontSize" Value="{DynamicResource {x:Static vsShell:VsFonts.EnvironmentFontSizeKey}}"/>
            <Setter Property="FontWeight" Value="Normal"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Red"/>
                    <!--<Setter Property="BorderBrush" Value="Aqua"/>-->
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <!--<Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="Aqua"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.ToolboxIconHighlightKey}}"/>
                                    </Trigger>-->
            </Style.Triggers>
        </Style>

        <!--____________________________________________-->
        <!--_______TabGroup Header Expander Style_______-->
        <!--____________________________________________-->
        <Style x:Key="ExpanderStyle" TargetType="{x:Type Expander}">

            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="ContextMenu" Value="{StaticResource TabGroupContextMenu}"/>

            <!-- Style to remove padding and border for the ListViewItem -->
            <Setter Property="Padding" Value="0"/>

            <Setter Property="BorderThickness" Value="0"/>

            <!-- Style to remove focus and more for the ListViewItem -->
            <!--<Setter Property="Focusable" Value="false"/>-->

            <!-- Style stretch the clickable content to the width of the window-->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>

            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="FontFamily" Value="{DynamicResource {x:Static  vsShell:VsFonts.EnvironmentFontFamilyKey}}"/>
            <!--<Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    -->
            <!--<Setter Property="Background" Value="Transparent" />
                 <Setter Property="BorderBrush" Value="Transparent" />
                 <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.DebuggerDataTipActiveHighlightTextKey}}"/>-->
            <!--
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    -->
            <!--<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.ToolboxIconHighlightKey}}"/>-->
            <!--
                </Trigger>
            </Style.Triggers>-->



            <Setter Property="BorderBrush" Value="Transparent"/>
            <!--<Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="true">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite" ContentTemplate="{TemplateBinding HeaderTemplate}" Content="{TemplateBinding Header}" ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" DockPanel.Dock="Top" FontStretch="{TemplateBinding FontStretch}" Foreground="{TemplateBinding Foreground}" FocusVisualStyle="{StaticResource ExpanderHeaderFocusVisual}" FontStyle="{TemplateBinding FontStyle}" FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" MinWidth="0" MinHeight="0" Padding="{TemplateBinding Padding}" Style="{StaticResource ExpanderDownHeaderStyle}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Focusable="false" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="true">
                                <Setter Property="Visibility" TargetName="ExpandSite" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>-->
        </Style>

        <!--_____________________________________________-->
        <!--____________TabInfo ListView Style____________-->
        <!--_____________________________________________-->
        <Style TargetType="ListView" x:Key="MasterListViewStyle" BasedOn="{StaticResource DefaultListViewStyle}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabInfoListViewStyle}"/>
            <EventSetter Event="SelectionChanged" Handler="ListView_SelectionChanged"/>
            <EventSetter Event="MouseDoubleClick" Handler="ModifyFilters_OnClick"/>
        </Style>

    </UserControl.Resources>


    <!--________________________________________________________________________________________________________________________________________________________________-->
    <!--_____________________________________________-->
    <!--___________Start of Vertical Stack___________-->
    <!--_____________________________________________-->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical">

            <!--______________________________________________-->
            <!--________________Options Window________________-->
            <!--______________________________________________-->
            <local:OptionsWindow/>

            <!--______________________________________________-->
            <!--__________________Search Box__________________-->
            <!--______________________________________________-->
            <Grid>
                <TextBox x:Name="searchTextBox"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     Margin="5"
                     Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                     BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                     BorderThickness="1"
                     Padding="5"
                     Text="Search..." Foreground="Gray"
                     TextChanged="searchTextBox_TextChanged"
                     KeyDown="SearchTextBox_OnKeyDown"

                     GotFocus="SearchTextBox_OnGotFocus"
                     LostFocus="SearchTextBox_OnLostFocus"
            />

                <Button Content="X" Width="27" Height="27"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                    Click="ButtonBase_OnClick"
                    />
            </Grid>


















            <!--_____________________________________________-->
            <!--_____________Tab Group List View_____________-->
            <!--_____________________________________________-->
            <ListView x:Name="TabGroupsListView"
                  Style="{StaticResource DefaultListViewStyle}"
                  d:DataContext="{d:DesignInstance Type=tabGroupScripts:TabGroup, IsDesignTimeCreatable=True}"
                  ItemsSource="{Binding GroupsDocumentWell.View}">

                <!-- GroupStyle defines the appearance of group headers -->
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate DataType="{x:Type tabGroupScripts:TabGroup}">
                                <!-- Header for each group -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ContextMenu="{StaticResource TabGroupContextMenu}">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding ItemCount}" FontSize="14" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <!-- ItemTemplate defines the appearance of each item in the ListView -->
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type tabGroupScripts:TabGroup}">
                        <!-- Nested ListView within each item -->
                        <ListView x:Name="TabInfoItemList"
                              Style="{StaticResource MasterListViewStyle}"
                              d:ItemsSource="{d:SampleData ItemCount=2}" 
                              ItemsSource="{Binding TabsInGroup}">

                            <!-- ItemTemplate for the nested ListView, showing individual tab info -->
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type tabGroupScripts:TabInfo}">
                                    <TextBlock Text="{Binding WindowName}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>















            <!--#region Unassigned Tabs ListView -->


            <!--_______________________________________________-->
            <!--___________Unassigned Tabs List View___________-->
            <!--_______________________________________________-->
            <ListView x:Name="UnassignedTabsListView" 
                  Style="{StaticResource MasterListViewStyle}"
                  ItemsSource="{Binding UnassignedTabsGroup.View}" 
                  >

                <!--____________________________________________-->
                <!--___________Unassigned Tabs Header___________-->
                <!--____________________________________________-->
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <DockPanel>
                                                <Expander Header="Unassigned Groups" 
                                                          Style="{StaticResource ExpanderStyle}"
                                                >
                                                    <Expander.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Grid FlowDirection="LeftToRight" 
                                                              HorizontalAlignment="{Binding Path=HorizontalAlignment, 
                                                                                            RelativeSource={RelativeSource FindAncestor, 
                                                                                            AncestorType={x:Type ContentPresenter}}, 
                                                                                            Mode=OneWayToSource}" >
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding}" Margin="0,0" />
                                                                <!--<Border Grid.Column="1" BorderThickness="0.5" BorderBrush="White" Height="1" />-->
                                                                <!--<TextBlock Grid.Column="2" Text="{Binding ItemCount}" FontSize="14" Foreground="Gray"/>-->

                                                            </Grid>
                                                        </DataTemplate>
                                                    </Expander.HeaderTemplate>
                                                    <ItemsPresenter FlowDirection="LeftToRight" />
                                                </Expander>
                                            </DockPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>
                <!--____________________________________________-->
                <!--__________Unassigned Tabs Contents__________-->
                <!--____________________________________________-->
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type tabGroupScripts:TabInfo}">
                        <TextBlock Text="{Binding WindowName}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>


            <!--#endregion Unassigned Tabs ListView -->

        </StackPanel>
    </ScrollViewer>
</UserControl>