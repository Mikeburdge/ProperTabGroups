<UserControl x:Class="ProperTabGroups.ProperTabGroupsWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsShell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:tabGroupScripts="clr-namespace:ProperTabGroups.TabGroupScripts"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:Background="White"
			 x:Name="window"
             DataContext="{Binding ElementName=window, Path=ViewModel}">


    <UserControl.Resources>

        <!--____________________________________________-->
        <!--___________VS Theme Base ListView___________-->
        <!--____________________________________________-->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
            <!-- Style to remove margin for the nested ListView -->
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Remove indentation for the nested ListView -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!--___________________________________________-->
        <!--______________Scroll Bar Base______________-->
        <!--___________________________________________-->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.ScrollBarThumbBackgroundKey}}"/>
        </Style>

        <!--_____________________________________________-->
        <!--______________Context Menu Base______________-->
        <!--_____________________________________________-->
        <Style TargetType="ContextMenu">

            <!-- Background and Foreground setters -->
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>

            <!-- Additional styling for better theme matching -->
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarBorderKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="MenuItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.MenuTextKey}}"/>
                        <!-- Hover and Pressed States -->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarHoverOverSelectedKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarTextSelectedKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarMouseDownBackgroundBeginKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.CommandBarTextSelectedKey}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <!-- Adjust the Popup part of the ContextMenu to ensure proper theming -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--_____________________________________________-->
        <!--___________TabGroup List View Item___________-->
        <!--_____________________________________________-->
        <Style TargetType="ListViewItem" x:Key="TabGroupListItem">

            <!-- Style to remove padding and border for the ListViewItem -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>

            <Setter Property="BorderThickness" Value="0"/>

            <!-- Style to remove focus and more for the ListViewItem -->
            <Setter Property="Focusable" Value="false"/>

            <!-- Style stretch the clickable content to the width of the window-->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <!--<Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="Red"/>-->
            <Setter Property="FontFamily" Value="{DynamicResource {x:Static  vsShell:VsFonts.EnvironmentFontFamilyKey}}"/>
            <Setter Property="FontSize" Value="{DynamicResource {x:Static vsShell:VsFonts.EnvironmentFontSizeKey}}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <!--<Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.DebuggerDataTipActiveHighlightTextKey}}"/>-->
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <!--<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.ToolboxIconHighlightKey}}"/>-->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--_____________________________________________-->
        <!--____________TabGroup Context Menu____________-->
        <!--_____________________________________________-->
        <ContextMenu x:Key="TabGroupContextMenu">
            <MenuItem Header="Rename" ></MenuItem>
            <MenuItem Header="Delete Group" Click="DeleteGroup_OnClick" />
        </ContextMenu>

        <!--_____________________________________________-->
        <!--____________TabGroup Context Menu____________-->
        <!--_____________________________________________-->
        <ContextMenu x:Key="TabInfoContextMenu">
            <MenuItem Header="Modify filters" Click="ModifyFilters_OnClick"></MenuItem>
            <MenuItem Header="Clear filters" Click="ClearFilters_OnClick"></MenuItem>
        </ContextMenu>

        <!--_____________________________________________-->
        <!--_________Group Hiding Bool Converter_________-->
        <!--_____________________________________________-->
        <!--<BooleanToVisibilityConverter x:Key="BoolToVis" />-->

        <!--_____________________________________________-->
        <!--____________Tab Group Title Style____________-->
        <!--_____________________________________________-->
        <Style TargetType="TextBlock" x:Key="TabGroupTitleStyles">
            <Setter Property="FontSize" Value="12"/>
            <!--<Setter Property="FontWeight" Value="SemiBold"/>-->
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="FontFamily" Value="{DynamicResource {x:Static  vsShell:VsFonts.EnvironmentFontFamilyKey}}"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <!-- Slightly more vertical spacing -->
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <!-- Adds an ellipsis if the text is too long -->
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!--_____________________________________________-->
        <!--____________Tab Group Title Style____________-->
        <!--_____________________________________________-->
        <Style TargetType="TextBlock" x:Key="TabInfoTitleStyles">

        </Style>
        
        <!--_____________________________________________-->
        <!--________Tab Info List View Item Style________-->
        <!--_____________________________________________-->
        <Style TargetType="ListViewItem" x:Key="TabInfoListViewItemStyle">

            <Setter Property="Padding" Value="0"/>
            <!-- Style to remove padding and border for the ListViewItem -->
            <Setter Property="Margin" Value="0"/>

            <Setter Property="BorderThickness" Value="1"/>
            <!--<Setter Property="BorderBrush" Value="Aqua"/>-->

            <!-- Style to select the tab when we want it selected -->
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />

            <!-- Style stretch the clickable content to the width of the window-->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <!-- Setting Context Menu for nested List View Items-->
            <Setter Property="ContextMenu" Value="{StaticResource TabInfoContextMenu}"/>

            <!-- Setting the background styles -->
            <!--<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>-->
            <!--<Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>-->
            <!--<Setter Property="FontFamily" Value="{DynamicResource {x:Static  vsShell:VsFonts.EnvironmentFontFamilyKey}}"/>-->
            <!--<Setter Property="FontSize" Value="{DynamicResource {x:Static vsShell:VsFonts.EnvironmentFontSizeKey}}"/>-->
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Orange"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <!--<Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="Aqua"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.ToolboxIconHighlightKey}}"/>
                                    </Trigger>-->
            </Style.Triggers>
        </Style>
        
        <!--_____________________________________________-->
        <!--________Tab Info List View Item Style________-->
        <!--_____________________________________________-->
        <Style TargetType="ListViewItem" x:Key="NestedListViewItemStyle">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <!--<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>-->

            <!-- Style to select the tab when we want it selected -->
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="MediumPurple"/>
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>

            

        </Style>
    </UserControl.Resources>


    <!--________________________________________________________________________________________________________________________________________________________________-->
                                                                    <!--_____________________________________________-->
                                                                    <!--___________Start of Vertical Stack___________-->
                                                                    <!--_____________________________________________-->
    <StackPanel Orientation="Vertical">

        <!--_____________________________________________-->
        <!--___________Add New Tab Group Stuff___________-->
        <!--_____________________________________________-->
        <Button Content="Add Tab Group" Click="AddNewGroup"/>
        <Popup Name="InputPopup" Placement="RelativePoint" Width="200" Height="100" IsOpen="False">
            <Border BorderBrush="Black" BorderThickness="1" Background="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}">
                <StackPanel Margin="10">
                    <TextBlock Text="Enter a string:"/>
                    <TextBox Name="InputTextBox"/>
                    <Button Content="Submit" Margin="0,10,0,0" Click="SubmitPopup_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!--_____________________________________________-->
        <!--_____________Tab Group List View_____________-->
        <!--_____________________________________________-->
        <ListView x:Name="TabGroupsListView"
                  Margin="0,0,0,0"
                  d:ItemsSource="{d:SampleData ItemCount=2}" 
                  ItemsSource="{Binding GroupsDocumentWell.View}"
                  ItemContainerStyle="{StaticResource TabGroupListItem}">

            <!--_____________________________________________-->
            <!--________Tab Group Higher Level Header________-->
            <!--_____________________________________________-->
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource TabGroupTitleStyles}"
                                           ContextMenu="{StaticResource TabGroupContextMenu}"/>
                                <!--<TextBlock Text="{Binding ItemCount}" FontSize="12" Foreground="Gray"/>-->
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <!--____________________________________________-->
            <!--________Tab Group Higher Level Items________-->
            <!--_________________Tab Infos__________________-->
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type tabGroupScripts:TabGroup}">
                    <ListView x:Name="ItemContainerList"
                              ItemsSource="{Binding TabsInGroup.View}"
                              SelectionChanged="ListView_SelectionChanged" 
                              MouseDoubleClick="ModifyFilters_OnClick"
                              ItemContainerStyle="{StaticResource NestedListViewItemStyle}">
                       
                        <!--_______________________________________________-->
                        <!--__________Tab Info List View Contents__________-->
                        <!--_______________________________________________-->
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type tabGroupScripts:TabInfo}">
                                <TextBlock Text="{Binding WindowName}"
                                           Style="{StaticResource TabInfoTitleStyles}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--_______________________________________________-->
        <!--___________Unassigned Tabs List View___________-->
        <!--_______________________________________________-->
        <!--Visibility="{Binding IsUnassignedListBoxVisible, Converter={StaticResource BoolToVis}}"-->
        <ListView x:Name="UnassignedTabsListView" 
                  Margin="0,0,0,0" 
                  d:ItemsSource="{d:SampleData ItemCount=2}" 
                  ItemsSource="{Binding UnassignedTabsGroup.View}" 
                  ItemContainerStyle="{StaticResource TabInfoListViewItemStyle}"
                  SelectionChanged="ListView_SelectionChanged" 
                  MouseDoubleClick="ModifyFilters_OnClick">

            <!--____________________________________________-->
            <!--___________Unassigned Tabs Header___________-->
            <!--____________________________________________-->
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Unassigned Groups" Style="{StaticResource TabGroupTitleStyles}" />
                                <!-- {Binding UnassignedTabsGroupName} -->
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <!--____________________________________________-->
            <!--__________Unassigned Tabs Contents__________-->
            <!--____________________________________________-->
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type tabGroupScripts:TabInfo}">
                    <TextBlock Text="{Binding WindowName}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</UserControl>