<UserControl x:Class="ProperTabGroups.ProperTabGroupsWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:ProperTabGroups"
			 xmlns:s="clr-namespace:ProperTabGroups.Subsystem"
             xmlns:vsShell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsFonts="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:Background="White"
			 x:Name="window"
             DataContext="{Binding ElementName=window, Path=ViewModel}">
	<!--<UserControl.DataContext>
        <s:TabGroupsSubsystem />
    </UserControl.DataContext>-->

	<UserControl.Resources>
		 <!--VS Theme ListView--> 
		<Style TargetType="ListView">
			<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
		</Style>

		<Style TargetType="ListViewItem">
			<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
			<!--<Setter Property="FontFamily" Value="{DynamicResource {x:Static vsFonts.EnvironmentFontFamilyKey}}"/>
			<Setter Property="FontSize" Value="{DynamicResource {x:Static vsFonts.EnvironmentFontSizeKey}}"/>-->
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.HighlightKey}}"/>
					<Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.HighlightTextKey}}"/>
				</Trigger>
				<Trigger Property="IsMouseOver" Value="True">
					<!--<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.ToolWindowHoverKey}}"/>-->
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style TargetType="ScrollBar">
			<Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.ScrollBarThumbBackgroundKey}}"/>
		</Style>
	</UserControl.Resources>

	<Grid>

		<!-- Title for the list of open documents -->
		<TextBlock Text="All Open Documents" Foreground="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}" FontWeight="Normal" FontSize="14" Margin="5"/>
		<ListView x:Name="tabGroupsListView" Margin="0,25,0,0" d:ItemsSource="{d:SampleData ItemCount=2}" ItemsSource="{Binding LocalDocumentWell.View}" SelectionChanged="ListView_SelectionChanged">

			<ListView.GroupStyle>
				<GroupStyle>
					
				</GroupStyle>
			</ListView.GroupStyle>

			<ListView.View>
				<GridView>
					<GridView.ColumnHeaderContainerStyle>
						<Style TargetType="{x:Type GridViewColumnHeader}">
							<Setter Property="Visibility" Value="Collapsed" />
						</Style>
					</GridView.ColumnHeaderContainerStyle>
					<GridViewColumn DisplayMemberBinding="{Binding WindowName}"/>
				</GridView>
			</ListView.View>
		</ListView>
	</Grid>
</UserControl>