<UserControl x:Class="ProperTabGroups.ProperTabGroupsWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsShell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:tabGroupScripts="clr-namespace:ProperTabGroups.TabGroupScripts"
             xmlns:local="clr-namespace:ProperTabGroups.ToolWindows.OptionsWindow"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:Background="White"
             x:Name="window"
             DataContext="{Binding ElementName=window, Path=ViewModel}">

    <UserControl.Resources>
        <!-- Default ListView Style -->
        <Style TargetType="ListView" x:Key="DefaultListViewStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Custom ListViewItem Style -->
        <Style TargetType="ListViewItem" x:Key="TabInfoListViewStyle">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContextMenu" Value="{StaticResource TabInfoContextMenu}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="FontFamily" Value="{DynamicResource {x:Static vsShell:VsFonts.EnvironmentFontFamilyKey}}"/>
            <Setter Property="FontSize" Value="{DynamicResource {x:Static vsShell:VsFonts.EnvironmentFontSizeKey}}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="Red"/>
                                <!--<Setter TargetName="" Property="FontWeight" Value="Bold"/>-->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expander Style for Group Headers -->
        <Style x:Key="ExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="ContextMenu" Value="{StaticResource TabGroupContextMenu}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsShell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="FontFamily" Value="{DynamicResource {x:Static vsShell:VsFonts.EnvironmentFontFamilyKey}}"/>
        </Style>

        <!-- Master ListView Style for main ListView and nested ListViews -->
        <Style TargetType="ListView" x:Key="MasterListViewStyle" BasedOn="{StaticResource DefaultListViewStyle}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabInfoListViewStyle}"/>
            <EventSetter Event="SelectionChanged" Handler="ListView_SelectionChanged"/>
            <EventSetter Event="MouseDoubleClick" Handler="ModifyFilters_OnClick"/>
        </Style>
    </UserControl.Resources>

    <!-- Main Content -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical">
            <!-- Options Window -->
            <local:OptionsWindow/>

            <!-- Search Box -->
            <Grid>
                <TextBox x:Name="searchTextBox"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"
                         Margin="5"
                         Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                         BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                         BorderThickness="1"
                         Padding="5"
                         Text="Search..." Foreground="Gray"
                         TextChanged="searchTextBox_TextChanged"
                         KeyDown="SearchTextBox_OnKeyDown"
                         GotFocus="SearchTextBox_OnGotFocus"
                         LostFocus="SearchTextBox_OnLostFocus"/>
                <Button Content="X" Width="27" Height="27"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                        Click="ButtonBase_OnClick"/>
            </Grid>

            <!-- ListView for Tab Groups -->
            <ListView x:Name="TabGroupsListView"
                      Style="{StaticResource DefaultListViewStyle}"
                      ItemsSource="{Binding GroupsDocumentWell.View}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- Using Expander for collapsible group headers -->
                        <Expander Header="{Binding Name}" Style="{StaticResource ExpanderStyle}">
                            <Expander.HeaderTemplate>
                                <DataTemplate>
                                    <Grid FlowDirection="LeftToRight" 
                                          HorizontalAlignment="{Binding Path=HorizontalAlignment, 
                                                                        RelativeSource={RelativeSource FindAncestor, 
                                                                        AncestorType={x:Type ContentPresenter}}, 
                                                                        Mode=OneWayToSource}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" Margin="0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </Expander.HeaderTemplate>
                            <!-- Nested ListView for tabs within each group -->
                            <ListView x:Name="TabInfoItemList"
                                      Style="{StaticResource MasterListViewStyle}"
                                      ItemsSource="{Binding TabsInGroup.View}">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type tabGroupScripts:TabInfo}">
                                        <TextBlock Text="{Binding WindowName}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ListView for Unassigned Tabs -->
            <ListView x:Name="UnassignedTabsListView"
                      Style="{StaticResource MasterListViewStyle}"
                      ItemsSource="{Binding UnassignedTabsGroup.View}">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <DockPanel>
                                                <Expander Header="Unassigned Groups" Style="{StaticResource ExpanderStyle}">
                                                    <Expander.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Grid FlowDirection="LeftToRight" 
                                                                  HorizontalAlignment="{Binding Path=HorizontalAlignment, 
                                                                                            RelativeSource={RelativeSource FindAncestor, 
                                                                                            AncestorType={x:Type ContentPresenter}}, 
                                                                                            Mode=OneWayToSource}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding}" Margin="0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </Expander.HeaderTemplate>
                                                    <ItemsPresenter FlowDirection="LeftToRight"/>
                                                </Expander>
                                            </DockPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type tabGroupScripts:TabInfo}">
                        <TextBlock Text="{Binding WindowName}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>