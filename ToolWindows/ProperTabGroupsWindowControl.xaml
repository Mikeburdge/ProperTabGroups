<UserControl x:Class="ProperTabGroups.ProperTabGroupsWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:ProperTabGroups" 
             xmlns:toolWindows="clr-namespace:ProperTabGroups.ToolWindows"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <toolWindows:CurrentlyActiveTabGroups x:Key="ActiveTabGroups"/>
    </UserControl.Resources>
    <UserControl.DataContext>
        <c:TabGroupsSubsystem />
    </UserControl.DataContext>
    <Grid>
        <ListView ItemsSource="{Binding LocalDocumentWell}">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Window.Caption}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>